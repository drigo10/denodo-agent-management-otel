# Copy to .env and edit locally. All values here are placeholders.
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Absolute path to your own Denodo Developer Tier license.
DENODO_LICENSE_FILE=/absolute/path/to/your/denodo.lic
DENODO_ADMIN_USER=admin
DENODO_ADMIN_PASSWORD=replace-with-a-local-password

# Use linux/amd64 for the pinned image, including on Apple Silicon.
DENODO_PLATFORM=linux/amd64

# Copy the full trace endpoint from your AM OpenTelemetry receiver setup panel.
AM_OTLP_TRACES_ENDPOINT=https://your-agent-management.example/dip/api/otlp/your-receiver/v1/traces
AM_API_KEY=replace-with-your-dataiku-key
OTEL_SERVICE_NAME=denodo-ai-sdk

# 0: export original Langfuse attributes; 1: add GenAI compatibility attributes.
DENODO_AM_NORMALIZE=1
